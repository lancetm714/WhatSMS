DEFAULT_DESTINATION=+1234567890
PORT=3000
DATA_DIR=./data

# textbee.dev SMS gateway (https://textbee.dev)
# Get your API key and Device ID from https://app.textbee.dev/dashboard
TEXBEE_API_KEY=your_api_key
TEXBEE_DEVICE_ID=your_device_id
TEXBEE_BASE_URL=https://api.textbee.dev
TEXBEE_TIMEOUT_MS=20000

# SMS delivery reliability (outbox queue + retry + delivery polling)
SMS_MAX_ATTEMPTS=5
SMS_RETRY_BASE_MS=5000
SMS_RETRY_MAX_MS=300000
SMS_WORKER_INTERVAL_MS=5000
SMS_POLL_INTERVAL_MS=15000
SMS_DELIVERY_FIRST_CHECK_MS=3000

# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
